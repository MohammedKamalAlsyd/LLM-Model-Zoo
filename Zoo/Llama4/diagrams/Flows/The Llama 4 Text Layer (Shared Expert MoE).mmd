graph TD
    Input_State("Layer Input Hidden States")

    subgraph Text_Decoder_Layer ["Llama 4 Decoder Layer"]
        %% Pre-Attention Norm
        Norm1["RMS Norm"]
        
        %% Attention Block
        subgraph Attention_Block ["Llama4TextAttention"]
            QKV["Q, K, V Projections"]
            RoPE["Rotary Embeddings<br/>(Applied to Q, K)"]
            TempTune["Temperature Tuning<br/>(If NoPE Layer)"]
            GQA["Grouped Query Attention"]
            OutProj["Output Projection"]
            
            QKV --> RoPE
            QKV --> TempTune
            RoPE --> GQA
            TempTune --> GQA
            GQA --> OutProj
        end

        %% Residual 1
        Res1((+))

        %% Post-Attention Norm
        Norm2["RMS Norm"]

        %% The Llama 4 MOE Block
        subgraph MoE_Block ["Llama4TextMoe (The Core Logic)"]
            direction TB
            
            %% Path Split
            Input_MoE["MoE Input"]
            
            %% Shared Path (Dense)
            Shared_Exp["<b>Shared Expert</b><br/>(Standard MLP)<br/>Processes ALL tokens"]
            
            %% Router Path (Sparse)
            Router["Router (Linear)"]
            TopK["Select Top-K Experts"]
            Gather["Gather Tokens"]
            Sparse_Exp["<b>Sparse Experts</b><br/>(SiLU Gated MLP)"]
            Scatter["Scatter Add<br/>(Combine Sparse Results)"]
            
            %% Logic flow
            Input_MoE --> Shared_Exp
            Input_MoE --> Router --> TopK
            Input_MoE --> Gather --> Sparse_Exp
            TopK -.->|Indices| Gather
            TopK -.->|Indices| Scatter
            Sparse_Exp --> Scatter
            
            %% Summation
            Sum_Experts((+))
            Shared_Exp --> Sum_Experts
            Scatter --> Sum_Experts
        end

        %% Residual 2
        Res2((+))
    end

    %% Wiring the Layer
    Input_State --> Norm1 --> Attention_Block --> Res1
    Input_State --> Res1
    
    Res1 --> Norm2 --> Input_MoE
    Sum_Experts --> Res2
    Res1 --> Res2

    Output_State("Next Hidden States")
    Res2 --> Output_State

    style MoE_Block fill:#fff9c4,stroke:#fbc02d,stroke-width:2px
    style Shared_Exp fill:#ffccbc,stroke:#d84315
    style Sparse_Exp fill:#c8e6c9,stroke:#2e7d32