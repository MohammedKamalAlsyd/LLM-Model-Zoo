graph TD
    %% Input Node
    InputNode("Input Hidden States<br/>Shape: (B, S, H)")

    %% Flattening
    Flatten("Flatten Batch & Seq<br/>Shape: (N, H)")
    
    %% Split Point
    InputNode --> Flatten
    
    %% --- SHARED EXPERT BRANCH ---
    subgraph Shared_Path ["Shared Expert Path"]
        direction TB
        SharedMLP("<b>self.shared_expert</b><br/>(Llama4TextMLP)")
        SharedOut("Shared Output<br/>Shape: (N, H)")
        
        Flatten --> SharedMLP --> SharedOut
    end

    %% --- ROUTER / SPARSE EXPERTS BRANCH ---
    subgraph MoE_Path ["MoE Routing Path"]
        direction TB
        
        Router("<b>self.router</b><br/>Linear Projection")
        RouterLogits("Router Logits<br/>Shape: (N, E)")
        
        RoutingOps("<b>Routing Operations</b><br/>1. TopK Selection<br/>2. Create Indices<br/>3. Sigmoid Scores")
        
        Gather("<b>Gather</b><br/>Expand tokens for Experts<br/>(Zero out non-TopK)")
        
        RoutedIn("Routed Input<br/>Shape: (E * N, H)")
        
        Experts("<b>self.experts</b><br/>(Llama4TextExperts)<br/><i>Batched Matrix Mult</i>")
        
        RoutedOut("Routed Output<br/>Shape: (E * N, H)")
        
        %% Connections
        Flatten --> Router --> RouterLogits --> RoutingOps
        Flatten --> Gather
        RoutingOps --> Gather
        Gather --> RoutedIn --> Experts --> RoutedOut
    end

    %% --- RECOMBINATION ---
    subgraph Merge ["Merge"]
        ScatterAdd("<b>Scatter Add</b><br/>Sum 'Routed Output' into<br/>'Shared Output' via Indices")
    end
    
    SharedOut --> ScatterAdd
    RoutedOut --> ScatterAdd
    
    %% Final Output
    OutputNode("Output Hidden States<br/>Shape: (B, S, H)")
    
    ScatterAdd --> OutputNode

    %% Styling
    style InputNode fill:#e1f5fe,stroke:#01579b
    style OutputNode fill:#e1f5fe,stroke:#01579b
    style ScatterAdd fill:#f3e5f5,stroke:#4a148c,stroke-width:2px
    
    style SharedMLP fill:#ffccbc,stroke:#bf360c
    style Experts fill:#c8e6c9,stroke:#2e7d32
    style Router fill:#fff9c4,stroke:#fbc02d