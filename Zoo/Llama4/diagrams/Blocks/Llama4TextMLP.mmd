graph TD
    %% Input Node
    Input([Input x<br/>Shape: Batch, Seq, Hidden])

    %% Split Logic
    subgraph SwiGLU_Mechanism [SwiGLU Mechanism]
        direction TB
        
        %% Left Branch (The Gate)
        GateProj[<b>gate_proj</b><br/>Linear: Hidden &rarr; Intermediate]
        SiLU[<b>activation_fn</b><br/>SiLU]
        
        %% Right Branch (The Value)
        UpProj[<b>up_proj</b><br/>Linear: Hidden &rarr; Intermediate]
        
        %% Element-wise Multiplication
        Multiply((Element-wise<br/>Multiplication))
    end

    %% Down Projection
    DownProj[<b>down_proj</b><br/>Linear: Intermediate &rarr; Hidden]
    
    %% Output Node
    Output([Output<br/>Shape: Batch, Seq, Hidden])

    %% Connections with Shapes
    Input --> GateProj
    Input --> UpProj

    GateProj -->|Shape: B, S, Intermediate| SiLU
    UpProj -->|Shape: B, S, Intermediate| Multiply
    SiLU -->|Shape: B, S, Intermediate| Multiply
    
    Multiply -->|Shape: B, S, Intermediate| DownProj
    DownProj --> Output

    %% Styling
    style Input fill:#e1f5fe,stroke:#01579b
    style Output fill:#e1f5fe,stroke:#01579b
    style Multiply fill:#fff9c4,stroke:#fbc02d
    style SiLU fill:#f3e5f5,stroke:#7b1fa2