graph TD
    classDef tensor fill:#f5f5f5,stroke:#616161,stroke-width:1px;
    classDef op fill:#ffffff,stroke:#1e88e5,stroke-width:2px;
    classDef norm fill:#fff8e1,stroke:#fbc02d,stroke-width:2px;
    classDef attn fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px;

    subgraph VisionStage [Vision Encoding Pipeline]
        Pix[pixel_values: B x 3 x 1008 x 1008]:::tensor --> PatchConv[Conv2d: k=14, s=14]:::op
        PatchConv --> ViTBlocks[32x ViT Layers: Window + Global Attn]:::attn
        ViTBlocks --> FPNNeck[FPN: 4x, 2x, 1x, 0.5x Pyramids]:::op
        FPNNeck --> FPNFeats[fpn_features: 4 scales x 256 dim]:::tensor
    end

    subgraph PromptStage [Prompt Encoding Pipeline]
        TextIDs[input_ids: B x 32]:::tensor --> TextTwr[24x CLIP Text Layers]:::attn
        TextTwr --> TProj[Linear: 1024 -> 256]:::op
        BoxCoord[input_boxes: B x N x 4]:::tensor --> RoI[RoI-Align Pooling + Sine Pos]:::op
        RoI --> GeoLayers[3x Geometry Attention Layers]:::attn
        TProj & GeoLayers --> CatPrompts[Concatenate Prompts: B x S x 256]:::tensor
    end

    subgraph DetrStage [DETR Encoder-Decoder]
        FPNFeats & CatPrompts --> DetrEnc[6x DETR Encoder Layers]:::attn
        DetrEnc --> EncFeats[enc_hidden: B x L x 256]:::tensor
        Queries[200 Learnable Queries + Presence]:::tensor --> DetrDec[6x DETR Decoder Layers + RPB]:::attn
        EncFeats & CatPrompts --> DetrDec
        DetrDec --> DecQueries[decoder_queries: B x 200 x 256]:::tensor
        DetrDec --> BoxHead[Box MLP -> cxcywh]:::op
    end

    subgraph MaskStage [Pixel Mask Prediction]
        DecQueries --> MaskEmbed[3x Layer Mask Embedder]:::op
        EncFeats & FPNFeats --> PixDec[Pixel Top-Down Decoder]:::op
        PixDec --> InstProj[Instance Conv 1x1]:::op
        MaskEmbed & InstProj --> Einsum[Einsum: BQC, BCHW -> BQHW]:::op
        Einsum --> RawMasks[pred_masks: B x 200 x 252 x 252]:::tensor
    end